<?xml version="1.0"?>
<robot name="robot_base" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Parameter ukuran, sesuaikan dengan fisik robot kamu -->
  <xacro:property name="chassis_length" value="0.20"/>
  <xacro:property name="chassis_width"  value="0.16"/>
  <xacro:property name="chassis_height" value="0.05"/>
  <xacro:property name="chassis_z"      value="0.04"/>

  <xacro:property name="wheel_radius"   value="0.026"/>
  <xacro:property name="wheel_width"    value="0.02"/>
  <xacro:property name="wheel_offset_y" value="0.085"/>

  <xacro:property name="lidar_radius"   value="0.035"/>
  <xacro:property name="lidar_height"   value="0.04"/>
  <xacro:property name="lidar_offset_x" value="0.06"/>
  <xacro:property name="lidar_offset_z" value="0.10"/>

  <material name="grey"><color rgba="0.5 0.5 0.5 1"/></material>
  <material name="black"><color rgba="0.1 0.1 0.1 1"/></material>
  <material name="orange"><color rgba="1.0 0.5 0.0 1"/></material>

  <!-- CHASSIS -->
  <link name="base_link"/>
  <link name="chassis">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
      <material name="grey"/>
    </visual>
  </link>

  <joint name="chassis_joint" type="fixed">
    <parent link="base_link"/>
    <child link="chassis"/>
    <origin xyz="0 0 ${chassis_z}" rpy="0 0 0"/>
  </joint>

  <!-- RODA KIRI -->
  <link name="left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
      <material name="black"/>
    </visual>
  </link>

  <joint name="left_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0 ${wheel_offset_y} 0" rpy="0 0 0"/>
  </joint>

  <!-- RODA KANAN -->
  <link name="right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
      <material name="black"/>
    </visual>
  </link>

  <joint name="right_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0 -${wheel_offset_y} 0" rpy="0 0 0"/>
  </joint>

  <!-- LIDAR (visual saja, condong ke depan; frame asli laser_link tetap dari static_transform_publisher) -->
  <link name="lidar_visual">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
      <material name="orange"/>
    </visual>
  </link>

  <joint name="lidar_visual_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_visual"/>
    <origin xyz="${lidar_offset_x} 0 ${lidar_offset_z}" rpy="0 0 0"/>
  </joint>

</robot>